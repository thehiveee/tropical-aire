# For Apache hosting (cPanel etc.). Netlify uses _redirects/_headers instead.
RewriteEngine On
# Force HTTPS and strip www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://tropical-aire.com%{REQUEST_URI} [L,R=301]
ErrorDocument 404 /404.html
RedirectMatch 301 ^/about-us/?$ /#why-us
RedirectMatch 301 ^/service-area/?$ /#areas
RedirectMatch 301 ^/reviews/?$ /#reviews
RedirectMatch 301 ^/specials/?$ /#rebates
RedirectMatch 301 ^/financing/?$ /#financing
RedirectMatch 301 ^/gallery/?$ /
RedirectMatch 301 ^/contact/?$ /#estimate
RedirectMatch 301 ^/terms-of-use/?$ /terms/
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json application/xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
